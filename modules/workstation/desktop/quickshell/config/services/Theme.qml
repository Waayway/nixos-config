pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

// Tokyo Night from tools/color.nix, generated by theme_home.nix as
// ~/.config/theme/colors.json. Literal fallbacks keep the bar readable
// without the file.
Singleton {
    id: root

    readonly property var c: {
        try {
            return JSON.parse(file.text());
        } catch (e) {
            return {};
        }
    }

    readonly property color bg: c.bg ?? "#1a1b26"
    readonly property color bgDark: c.bg_dark ?? "#16161e"
    readonly property color bgHighlight: c.bg_highlight ?? "#292e42"
    readonly property color fg: c.fg ?? "#c0caf5"
    readonly property color fgDark: c.fg_dark ?? "#a9b1d6"
    readonly property color comment: c.comment ?? "#565f89"
    readonly property color blue: c.blue ?? "#7aa2f7"
    readonly property color blue5: c.blue5 ?? "#89ddff"
    readonly property color blue7: c.blue7 ?? "#394b70"
    readonly property color cyan: c.cyan ?? "#7dcfff"
    readonly property color magenta: c.magenta ?? "#bb9af7"
    readonly property color purple: c.purple ?? "#9d7cd8"
    readonly property color green: c.green ?? "#9ece6a"
    readonly property color yellow: c.yellow ?? "#e0af68"
    readonly property color red: c.red ?? "#f7768e"
    readonly property color red1: c.red1 ?? "#db4b4b"

    readonly property string font: "JetBrainsMono Nerd Font"
    // Icons: the proportional variant gives Nerd Font icons their real width,
    // so they centre in their boxes (the plain one squeezes them to one cell).
    readonly property string iconFont: "JetBrainsMono Nerd Font Propo"
    readonly property int rounding: 12

    FileView {
        id: file
        path: Quickshell.env("HOME") + "/.config/theme/colors.json"
        blockLoading: true
        watchChanges: true
        onFileChanged: reload()
    }
}
